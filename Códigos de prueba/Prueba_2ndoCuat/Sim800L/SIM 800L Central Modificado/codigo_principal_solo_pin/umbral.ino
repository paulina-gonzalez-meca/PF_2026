void switchUmbral(int tipoSns, String lectura, int umbralMaximo, int umbralMinimo, int &emg){
  switch(tipoSns){
    case 0:
      emg = 0;
      break;
    case 1:
      if(lectura == "-" || lectura == "ERROR"){
        emg = 0;
      }
      else if(isDigit(lectura.charAt(0)) || isDigit(lectura.charAt(1))){
        if(lectura.toInt() >= umbralMaximo){
          emg = 2;
        }
        else if(lectura.toInt() <= umbralMinimo){
          emg = 1;
        }
        else{
          emg = 0;
        }
      }
      else{
        emg = 0;
      }
      break;
    case 2:
      if(isDigit(lectura.charAt(0))){
        if(lectura.toInt() == 0){
          emg = 0;
        }
        else if(lectura.toInt() == 1){
          emg = 1;
        }
      }
      else{
        emg = 0;
      }
      break;
  }
}